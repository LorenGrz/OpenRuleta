# Copy to .env.local in this directory (apps/form).
# Supabase → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon / publishable key (NOT service_role). RLS restricts it to INSERT on
# `participants`: it cannot read, update or delete anything.
SUPABASE_ANON_KEY=eyJhbGciOi...

# ── No database? ──────────────────────────────────────────────────────────
# With NO Supabase vars set (e.g. a fresh clone with no .env.local at all), the
# app falls back to a local file-backed mock store so you can try it right away.
# Force it on/off explicitly with:
# OPENRULETA_MOCK_DB=1
