# Copy to .env.local in this directory (apps/ruleta).
# Supabase → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# REQUIRED. The anon key is INSERT-only under RLS, so it cannot run the wheel
# (which needs SELECT / UPDATE / DELETE). Use the service_role key — it bypasses
# RLS, so keep it server-side only (it never reaches the browser).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional historical fallback. Not enough on its own to run the wheel.
# SUPABASE_ANON_KEY=eyJhbGciOi...

# OPTIONAL — password gate (HTTP Basic Auth) for the whole app, pages and API.
# Leave unset to run open on localhost. Set it to "user:password" before
# hosting this app anywhere public: without it, anyone with the URL can spin
# the wheel and delete participants through the service_role-backed API.
# RULETA_BASIC_AUTH=operator:choose-a-strong-password

# OPTIONAL — real winner email over SMTP. Without these the "Notify by email"
# button only simulates the send (preview, nothing leaves the machine).
# Gmail: turn on 2-Step Verification, then Google account → Security →
# App passwords, and paste the 16-character password here. The mail goes out
# from SMTP_USER; siteConfig.ruleta.email.from only supplies the display name.
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Optional overrides (defaults: smtp.gmail.com, 465 with TLS, from = SMTP_USER):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=your.account@gmail.com

# ── No database? ──────────────────────────────────────────────────────────
# With NO Supabase vars set (e.g. a fresh clone with no .env.local at all), the
# wheel falls back to a local file-backed mock store, pre-seeded with a handful
# of participants so you can spin straight away. Force it on/off explicitly:
# OPENRULETA_MOCK_DB=1
